
class Vehicle {

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 50");
    }
}

class Car extends Vehicle {

    @Override
    void calculateFee() {
        System.out.println("Car Parking Fee: Rs. 100");
    }
}

public class Main {
    public static void main(String[] args) {

        Car c = new Car();
        c.calculateFee();
    }
}
